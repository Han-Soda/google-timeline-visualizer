<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="24dp" android:paddingEnd="16dp" android:paddingBottom="32dp">
        <TextView android:id="@+id/settingsTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="4dp" android:paddingEnd="4dp" android:text="@string/settings" android:textAppearance="?attr/textAppearanceHeadlineMedium" android:textStyle="bold" />
        <TextView android:id="@+id/settingsSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:text="@string/settings_summary" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout android:id="@+id/customizeSettingsActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:visibility="gone">
            <com.google.android.material.button.MaterialButton android:id="@+id/cancelCustomizeButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:text="@string/cancel" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/applyCustomizeButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:text="@string/apply" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/timelineDataCard"
            style="@style/TimelineVisualizer.SettingsCard"
            android:layout_marginTop="20dp">

            <LinearLayout style="@style/TimelineVisualizer.SettingsCardContent">
                <LinearLayout
                    android:id="@+id/journalSetupIntro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/journal_setup_intro_title"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/journal_setup_intro_detail"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />
                </LinearLayout>
                <TextView android:id="@+id/timelineDataTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/timeline_data" android:textAppearance="?attr/textAppearanceTitleMedium" android:textStyle="bold" />
                <TextView android:id="@+id/timelineDataStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:accessibilityLiveRegion="polite" android:text="@string/timeline_source_empty" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                <TextView android:id="@+id/journalFreshnessStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textAppearance="?attr/textAppearanceBodyMedium" android:textStyle="bold" android:visibility="gone" tools:text="New route detail was preserved 8 days ago" tools:visibility="visible" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/journalReminderSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/journal_reminders" android:visibility="gone" tools:visibility="visible" />
                <TextView android:id="@+id/journalReminderSummary" style="@style/TimelineVisualizer.SettingSummary" android:text="@string/journal_reminders_summary" android:visibility="gone" tools:visibility="visible" />
                <LinearLayout
                    android:id="@+id/settingsTimelineProgressGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/settingsTimelineProgressStage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/opening_timeline"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textStyle="bold" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/settingsTimelineProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:indeterminate="true"
                        android:max="1000" />

                    <TextView
                        android:id="@+id/settingsTimelineProgressDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/journal_import_working_detail"
                        android:textAppearance="?attr/textAppearanceBodySmall" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/settingsImportTimelineButton" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/import_or_update" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsWhyImportButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:minHeight="48dp"
                    android:text="@string/settings_why_import_title"
                    android:visibility="gone"
                    tools:visibility="visible" />
                <TextView
                    android:id="@+id/settingsWhyImportDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/settings_why_import_detail"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:visibility="gone"
                    tools:visibility="visible" />
                <com.google.android.material.button.MaterialButton android:id="@+id/settingsTimelineHelpButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/get_timeline_file" />
                <com.google.android.material.button.MaterialButton android:id="@+id/settingsTimelineRestoreButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/backup_restore_timeline" />
                <com.google.android.material.button.MaterialButton android:id="@+id/settingsJournalHowItWorksButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/journal_how_it_works" android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TimelineVisualizer.SectionTitle" android:accessibilityHeading="true" android:text="@string/video_defaults" />
        <TextView style="@style/TimelineVisualizer.SectionSummary" android:text="@string/video_defaults_summary" />
        <com.google.android.material.card.MaterialCardView style="@style/TimelineVisualizer.SettingsCard">
            <LinearLayout style="@style/TimelineVisualizer.SettingsCardContent">
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/aspect_ratio">
                    <AutoCompleteTextView android:id="@+id/aspectRatioDropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/map_view">
                    <AutoCompleteTextView android:id="@+id/cameraMovementDropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:id="@+id/cameraMovementHelpText" style="@style/TimelineVisualizer.SettingSummary" android:layout_marginTop="6dp" tools:text="Gentle zoom changes for a stable view." />
                <TextView style="@style/TimelineVisualizer.SettingSummary" android:layout_marginTop="4dp" android:text="@string/automatic_visual_pacing_summary" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/tripDetectionInputLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/trip_detection" android:visibility="gone">
                    <AutoCompleteTextView android:id="@+id/tripDetectionDropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/localFramingInputLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/episode_framing" android:visibility="gone">
                    <AutoCompleteTextView android:id="@+id/localFramingDropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/longTripInputLayout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/long_trip_compression" android:visibility="gone">
                    <AutoCompleteTextView android:id="@+id/longTripDropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/resetAdvancedSettingsButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:maxLines="1" android:text="@string/reset_video_defaults" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/saveDefaultsAsPresetButton" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="@string/save_as_preset" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/managePresetsButton" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="@string/manage_presets" />
                </LinearLayout>
                <TextView style="@style/TimelineVisualizer.SettingSummary" android:layout_marginTop="4dp" android:text="@string/manage_presets_summary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TimelineVisualizer.SectionTitle" android:accessibilityHeading="true" android:text="@string/animation_settings" />
        <TextView style="@style/TimelineVisualizer.SectionSummary" android:text="@string/animation_settings_summary" />
        <com.google.android.material.card.MaterialCardView style="@style/TimelineVisualizer.SettingsCard">
            <LinearLayout style="@style/TimelineVisualizer.SettingsCardContent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView style="@style/TimelineVisualizer.SliderLabel" android:text="@string/zoom_smoothness" />
                    <TextView android:id="@+id/zoomSmoothnessValue" style="@style/TimelineVisualizer.SliderValue" tools:text="60%" />
                </LinearLayout>
                <com.google.android.material.slider.Slider android:id="@+id/zoomSmoothnessSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/zoom_smoothness" android:stepSize="5" android:value="60" android:valueFrom="0" android:valueTo="100" app:labelBehavior="gone" />
                <TextView style="@style/TimelineVisualizer.SettingSummary" android:text="@string/zoom_smoothness_summary" />

                <com.google.android.material.divider.MaterialDivider style="@style/TimelineVisualizer.SettingsDivider" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView style="@style/TimelineVisualizer.SliderLabel" android:text="@string/route_points" />
                    <TextView android:id="@+id/routePointSpacingValue" style="@style/TimelineVisualizer.SliderValue" tools:text="All points" />
                </LinearLayout>
                <com.google.android.material.slider.Slider android:id="@+id/routePointSpacingSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/route_points" android:stepSize="1" android:value="0" android:valueFrom="0" android:valueTo="8" app:labelBehavior="gone" />
                <TextView style="@style/TimelineVisualizer.SettingSummary" android:text="@string/route_points_summary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TimelineVisualizer.SectionTitle" android:accessibilityHeading="true" android:text="@string/route_and_overlay" />
        <com.google.android.material.card.MaterialCardView style="@style/TimelineVisualizer.SettingsCard">
            <LinearLayout style="@style/TimelineVisualizer.SettingsCardContent" android:paddingTop="8dp">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/keepPastRoutesVisibleSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/keep_past_routes_visible" />
                <TextView style="@style/TimelineVisualizer.SettingSummary" android:text="@string/keep_past_routes_visible_summary" />
                <LinearLayout android:id="@+id/pastRouteOpacityGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView style="@style/TimelineVisualizer.SliderLabel" android:text="@string/past_route_opacity" />
                        <TextView android:id="@+id/pastRouteOpacityValue" style="@style/TimelineVisualizer.SliderValue" tools:text="45%" />
                    </LinearLayout>
                    <com.google.android.material.slider.Slider android:id="@+id/pastRouteOpacitySlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="@string/past_route_opacity" android:stepSize="5" android:value="45" android:valueFrom="10" android:valueTo="100" app:labelBehavior="gone" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider style="@style/TimelineVisualizer.SettingsDivider" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" />

                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/hideDatesSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hide_dates" />
                <TextView style="@style/TimelineVisualizer.SettingSummary" android:text="@string/hide_dates_summary" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/simplifyRouteDetailSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/simplify_route_detail" />
                <TextView style="@style/TimelineVisualizer.SettingSummary" android:text="@string/simplify_route_detail_summary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TimelineVisualizer.SectionTitle" android:accessibilityHeading="true" android:text="@string/export_quality" />
        <TextView style="@style/TimelineVisualizer.SectionSummary" android:text="@string/export_quality_summary" />
        <com.google.android.material.card.MaterialCardView style="@style/TimelineVisualizer.SettingsCard">
            <LinearLayout style="@style/TimelineVisualizer.SettingsCardContent">
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/resolution">
                    <AutoCompleteTextView android:id="@+id/videoQualityDropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/frame_rate">
                    <AutoCompleteTextView android:id="@+id/frameRateDropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:id="@+id/videoFormatWarningText" style="@style/TimelineVisualizer.SettingSummary" android:layout_marginTop="8dp" android:textColor="?attr/colorError" android:visibility="gone" tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TimelineVisualizer.SectionTitle" android:accessibilityHeading="true" android:text="@string/regional_preferences" />
        <com.google.android.material.card.MaterialCardView style="@style/TimelineVisualizer.SettingsCard">
            <LinearLayout style="@style/TimelineVisualizer.SettingsCardContent">
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/language">
                    <AutoCompleteTextView android:id="@+id/languageDropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/distance_unit_setting">
                    <AutoCompleteTextView android:id="@+id/distanceUnitDropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TimelineVisualizer.SectionTitle" android:accessibilityHeading="true" android:text="@string/about_and_privacy" />
        <com.google.android.material.card.MaterialCardView style="@style/TimelineVisualizer.SettingsCard">
            <LinearLayout style="@style/TimelineVisualizer.SettingsCardContent" android:paddingBottom="8dp">
                <TextView android:id="@+id/versionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleSmall" tools:text="Version 2.3.0 (33)" />
                <TextView android:id="@+id/privacyText" style="@style/TimelineVisualizer.SettingSummary" android:layout_marginTop="8dp" android:text="@string/privacy_summary" />
                <TextView style="@style/TimelineVisualizer.SettingSummary" android:layout_marginTop="6dp" android:text="@string/geonames_attribution" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
                    <com.google.android.material.button.MaterialButton android:id="@+id/privacyPolicyButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="-12dp" android:maxLines="1" android:text="@string/privacy_policy" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/checkUpdatesButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="-12dp" android:maxLines="1" android:text="@string/check_for_updates" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/githubProjectButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="-12dp" android:maxLines="1" android:text="@string/project_on_github" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
